{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prio-board.schema.json",
  "title": "Prio-Board",
  "description": "Austauschformat des Prio-Boards (Version 3): Aufgaben (Denken/Umsetzung) auf einer Zeitachse mit Priorität, Dauer, Iterationen, Themen und Abhängigkeiten.",
  "type": "object",
  "required": ["format", "version", "tasks", "dependencies"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "prio-board" },
    "version": { "const": 3 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "board": {
      "type": "object",
      "properties": { "title": { "type": "string" } },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": { "zoom": { "type": "number", "minimum": 0.3, "maximum": 2 } },
      "additionalProperties": false
    },
    "themes": {
      "description": "Themen fassen Aufgaben zusammen (Rahmen je Prio-Band). Eine Abhängigkeit auf/von einem Thema gilt für alle Aufgaben darin.",
      "type": "array",
      "items": { "$ref": "#/$defs/theme" }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "dependencies": {
      "description": "\"from\" muss fertig sein (bzw. die Iteration \"fromIteration\"), bevor \"to\" startet. Beides: Aufgabe oder Thema.",
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "analysis": {
      "description": "Nur im Export: beim Export berechnete Auswertung. Wird beim Import ignoriert.",
      "type": "object",
      "properties": {
        "note": { "type": "string" },
        "planEnd": { "type": "string", "format": "date" },
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "end": { "type": "string", "format": "date" },
              "durationDays": { "type": "integer" },
              "wave": { "type": ["integer", "null"], "description": "Gleiche Welle = parallel bearbeitbar; null bei erledigt/Zyklus" },
              "state": { "enum": ["done", "cycle", "in_progress", "ready", "waiting"] },
              "leverage": { "type": "integer", "description": "Anzahl offener Umsetzungen, die (indirekt) von dieser Aufgabe abhängen" },
              "blockedBy": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "waves": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
        "importantThinking": { "type": "array", "items": { "type": "string" }, "description": "Offene Denk-Themen, sortiert nach Hebel × Dauer" },
        "criticalPath": {
          "type": "object",
          "properties": {
            "tasks": { "type": "array", "items": { "type": "string" } },
            "durationDays": { "type": "integer" }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "days": { "type": "integer", "minimum": 1, "description": "Arbeitstage (Mo–Fr); 5 = eine Woche" },
    "intensity": {
      "enum": ["focused", "medium", "background"],
      "default": "focused",
      "description": "focused = intensiv · medium = mittel · background = nebenbei / reift"
    },
    "theme": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      },
      "additionalProperties": false
    },
    "iteration": {
      "type": "object",
      "required": ["title", "durationDays"],
      "properties": {
        "title": { "type": "string" },
        "durationDays": { "$ref": "#/$defs/days" },
        "intensity": { "$ref": "#/$defs/intensity" },
        "done": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "kind", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["thinking", "implementation"],
          "description": "thinking = Denken (Analyse, braucht Zeit) · implementation = Umsetzung (direkt machbar)"
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" }, "description": "Stichpunkte" },
        "status": { "enum": ["open", "in_progress", "done"], "default": "open" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3, "description": "1 = sehr hoch (oben) … 5 = sehr tief" },
        "start": { "type": "string", "format": "date", "description": "Starttag; Daten vor heute werden auf heute gesetzt" },
        "durationDays": { "$ref": "#/$defs/days", "description": "Dauer in Arbeitstagen (bei Iterationen: Summe der Iterationen)" },
        "bufferDays": { "type": "integer", "minimum": 0, "default": 0, "description": "Puffer/Unsicherheit in Arbeitstagen" },
        "intensity": { "$ref": "#/$defs/intensity", "description": "Arbeitsweise ohne Iterationen (mit Iterationen gilt die jeweilige Iteration)" },
        "ongoing": { "type": "boolean", "default": false, "description": "Nur Denken: läuft nach der Dauer weiter (∞)" },
        "iterations": { "type": "array", "items": { "$ref": "#/$defs/iteration" }, "description": "Nur Denken: Schritte nacheinander" },
        "theme": { "type": ["string", "null"], "minLength": 1, "description": "ID des Themas (höchstens eines)" }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "fromIteration": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Index der Iteration von \"from\", die reicht (null = ganze Aufgabe)"
        }
      },
      "additionalProperties": false
    }
  }
}
